# LIMS Backend environment template
# Copy to .env for local non-container runs.

# Runtime mode/profile
ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=local

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lims
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

# Migration/JPA behavior
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1

# Report storage
REPORT_STORAGE_PROVIDER=local
REPORT_STORAGE_LOCAL_BASE_PATH=/tmp/lims-reports

# Security/JWT
JWT_SECRET=local-secret-key-local-secret-key-local-secret-key
JWT_EXPIRATION=86400

# Internal service communication
INTERNAL_AUTH_MODE=local
INTERNAL_SECRET_KEY=replace-with-shared-internal-secret
INTERNAL_ALLOWED_SERVICE_ACCOUNTS=

# Service URLs
LIMS_SERVICE_URL=http://localhost:8080
LIMS_SERVICE_URL_CLOUD=
PHR_SERVICE_URL=http://localhost:8000
PHR_SERVICE_URL_CLOUD=

# Optional GCP integration
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
SPRING_CLOUD_GCP_ENABLED=false
SPRING_CLOUD_GCP_STORAGE_ENABLED=false
